<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad de red: la app solo acepta conexiones cifradas (HTTPS/TLS).
     Cualquier conexión sin cifrar (http://) es bloqueada por Android. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Solo certificados oficiales del sistema -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
