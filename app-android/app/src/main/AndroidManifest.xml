<?xml version="1.0" encoding="utf-8"?>
<!-- Hecho con IA (Claude) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para usar internet (WiFi o datos móviles) y conectarse a Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup="false": los datos de la app no se copian en respaldos
         networkSecurityConfig: solo conexiones cifradas (HTTPS/TLS) -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonitorEstructural">

        <!-- La app parte en el login -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".InicioActivity" android:exported="false" />
        <activity android:name=".MonitoreoActivity" android:exported="false" />
        <activity android:name=".DetalleActivity" android:exported="false" />
        <activity android:name=".ActivadorActivity" android:exported="false" />
    </application>

</manifest>
